<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:theme="@style/AppTheme" android:label="Wfmusic" android:icon="@drawable/ic_wf_logo" android:allowBackup="true" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".YouTubeWebViewActivity" android:screenOrientation="portrait" android:exported="false" />
        <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
