<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111318">
    <ScrollView android:id="@+id/downloadPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFFLINE MUSIC" android:textColor="#A7F36B" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.16" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download what you’re allowed to keep." android:textColor="#F4F5F7" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use direct audio URLs, or connect the optional yt-dlp + FFmpeg extractor." android:textColor="#AEB4C0" android:textSize="13sp" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXTRACTOR SERVICE URL" android:textColor="#F4F5F7" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="26dp" />
            <EditText android:id="@+id/serviceUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="http://10.0.2.2:8000" android:singleLine="true" android:inputType="textUri" android:textColor="#F4F5F7" android:textColorHint="#687180" android:backgroundTint="#4D5563" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="The embedded converter is used first. The service URL is an optional fallback." android:textColor="#687180" android:textSize="11sp" android:layout_marginTop="4dp" />
            <Switch android:id="@+id/internetToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INTERNET ACCESS FOR WMUSIC" android:textColor="#F4F5F7" android:checked="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/importCookiesButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="OPEN YOUTUBE / VERIFY" android:textSize="10sp" />
                <Button android:id="@+id/removeCookiesButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REMOVE" android:textSize="10sp" android:layout_marginStart="8dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEDIA URL" android:textColor="#F4F5F7" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="22dp" />
            <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Paste a direct audio URL or YouTube URL" android:singleLine="true" android:inputType="textUri" android:textColor="#F4F5F7" android:textColorHint="#687180" android:backgroundTint="#4D5563" />
            <Button android:id="@+id/downloadButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DOWNLOAD / CONVERT TO MP3" android:textColor="#111318" android:backgroundTint="#A7F36B" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only download content you own or have permission to save. The app does not bypass DRM, private content, or access controls." android:textColor="#687180" android:textSize="11sp" android:layout_marginTop="22dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/libraryPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOWNLOADED MUSIC" android:textColor="#A7F36B" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.12" />
        <TextView android:id="@+id/libraryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your downloaded tracks will appear here." android:textColor="#687180" android:textSize="13sp" android:paddingTop="14dp" />
        <ListView android:id="@+id/libraryList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#252A33" android:dividerHeight="1dp" android:paddingTop="8dp" />
        <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="#F4F5F7" android:textSize="15sp" android:ellipsize="end" android:maxLines="1" android:paddingTop="12dp" />
        <SeekBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:progressTint="#A7F36B" android:thumbTint="#A7F36B" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/elapsedText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="#687180" android:textSize="11sp" />
            <TextView android:id="@+id/durationText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#687180" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <Button android:id="@+id/shuffleButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHUFFLE" android:textSize="10sp" />
            <Button android:id="@+id/previousButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="|&lt;&lt;" android:textSize="12sp" />
            <Button android:id="@+id/playPauseButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAY" android:textColor="#111318" android:backgroundTint="#A7F36B" />
            <Button android:id="@+id/nextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;&gt;|" android:textSize="12sp" />
            <Button android:id="@+id/repeatButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REPEAT OFF" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#1B1F27">
        <TextView android:id="@+id/downloadTab" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:text="DOWNLOAD" android:textColor="#A7F36B" android:textStyle="bold" />
        <TextView android:id="@+id/libraryTab" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:text="LIBRARY / PLAYER" android:textColor="#AEB4C0" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
