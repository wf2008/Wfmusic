<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B0D10">
    <ScrollView android:id="@+id/downloadPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="18dp" android:paddingRight="20dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_wf_logo" android:contentDescription="Wfmusic logo" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WFMUSIC" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.18" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your music, offline." android:textColor="#788392" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL PLAYER" android:textColor="#788392" android:textSize="10sp" android:letterSpacing="0.08" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save what you’re allowed to keep." android:textColor="#F5F7FA" android:textSize="30sp" android:textStyle="bold" android:lineSpacingExtra="2dp" android:layout_marginTop="26dp" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Paste a link and preview it before downloading." android:textColor="#9AA4B2" android:textSize="13sp" android:layout_marginTop="8dp" />
            <EditText android:id="@+id/serviceUrlInput" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:layout_marginTop="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECTION" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12" />
                <Switch android:id="@+id/internetToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Internet access" android:textColor="#F5F7FA" android:textSize="15sp" android:checked="true" android:layout_marginTop="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Controls new Wfmusic requests. Offline playback still works when it is off." android:textColor="#788392" android:textSize="11sp" android:layout_marginTop="-2dp" />
                <Button android:id="@+id/importCookiesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPEN YOUTUBE / VERIFY SESSION" android:textColor="#F5F7FA" android:textSize="11sp" android:background="@drawable/bg_secondary_button" android:layout_marginTop="12dp" />
                <Button android:id="@+id/removeCookiesButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLEAR SESSION" android:textColor="#9AA4B2" android:textSize="10sp" android:background="@drawable/bg_secondary_button" android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:layout_marginTop="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VIDEO LINK" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12" />
                <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Paste YouTube or audio URL" android:singleLine="true" android:inputType="textUri" android:textColor="#F5F7FA" android:textColorHint="#657080" android:background="@drawable/bg_input" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/previewText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Video details will appear here before anything is downloaded." android:textColor="#AEB7C4" android:textSize="14sp" android:background="#11151A" android:padding="14dp" android:layout_marginTop="12dp" />
                <ProgressBar android:id="@+id/busyProgress" android:layout_width="match_parent" android:layout_height="4dp" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:indeterminateTint="#B7F36B" android:visibility="gone" android:layout_marginTop="10dp" />
                <Button android:id="@+id/confirmDownloadButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DOWNLOAD THIS VIDEO" android:textColor="#0B0D10" android:textStyle="bold" android:background="@drawable/bg_primary_button" android:visibility="gone" android:layout_marginTop="10dp" />
                <Button android:id="@+id/downloadButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="PREVIEW / DOWNLOAD" android:textColor="#0B0D10" android:textStyle="bold" android:background="@drawable/bg_primary_button" android:layout_marginTop="12dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only download content you own or have permission to save. Wfmusic does not bypass DRM, private content, or access controls." android:textColor="#657080" android:textSize="11sp" android:layout_marginTop="14dp" android:layout_marginBottom="10dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/libraryPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="18dp" android:paddingTop="18dp" android:paddingRight="18dp" android:paddingBottom="8dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR LIBRARY" android:textColor="#788392" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.16" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloaded music" android:textColor="#F5F7FA" android:textStyle="bold" android:textSize="27sp" android:layout_marginTop="4dp" />
            </LinearLayout>
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_wf_logo" android:contentDescription="Wfmusic logo" android:background="#20262D" android:padding="9dp" />
        </LinearLayout>
        <EditText android:id="@+id/librarySearch" android:layout_width="match_parent" android:layout_height="46dp" android:hint="Search songs, artists, albums" android:singleLine="true" android:textColor="#F5F7FA" android:textColorHint="#788392" android:background="@drawable/bg_input" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginTop="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:text="ALL SONGS" android:textColor="#0B0D10" android:textStyle="bold" android:textSize="10sp" android:background="@drawable/bg_primary_button" android:paddingLeft="14dp" android:paddingRight="14dp" />
            <TextView android:id="@+id/libraryCount" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:text="0 TRACKS" android:textColor="#9AA4B2" android:textSize="10sp" android:background="@drawable/bg_secondary_button" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginStart="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center_vertical|right" android:text="RECENTLY ADDED" android:textColor="#B7F36B" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/libraryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your downloaded tracks will appear here." android:textColor="#788392" android:textSize="13sp" android:paddingTop="14dp" />
        <ListView android:id="@+id/libraryList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#252C35" android:dividerHeight="1dp" android:paddingTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:id="@+id/nowPlayingArt" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_wf_logo" android:contentDescription="Current album artwork" android:background="#20262D" android:padding="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOW PLAYING" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="9sp" android:letterSpacing="0.12" />
                    <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="#F5F7FA" android:textSize="15sp" android:textStyle="bold" android:ellipsize="end" android:maxLines="1" android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/nowPlayingArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a track" android:textColor="#9AA4B2" android:textSize="12sp" android:ellipsize="end" android:maxLines="1" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/playPauseButton" android:layout_width="58dp" android:layout_height="48dp" android:text="PLAY" android:textColor="#0B0D10" android:textStyle="bold" android:textSize="10sp" android:background="@drawable/bg_primary_button" />
            </LinearLayout>
            <SeekBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:progressTint="#B7F36B" android:thumbTint="#B7F36B" android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/elapsedText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="#788392" android:textSize="10sp" /><TextView android:id="@+id/durationText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#788392" android:textSize="10sp" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="3dp">
                <Button android:id="@+id/shuffleButton" android:layout_width="wrap_content" android:layout_height="34dp" android:text="SHUFFLE" android:textSize="9sp" android:background="@drawable/bg_secondary_button" />
                <Button android:id="@+id/previousButton" android:layout_width="wrap_content" android:layout_height="34dp" android:text="|&lt;&lt;" android:textSize="10sp" android:background="@drawable/bg_secondary_button" />
                <Button android:id="@+id/nextButton" android:layout_width="wrap_content" android:layout_height="34dp" android:text="&gt;&gt;|" android:textSize="10sp" android:background="@drawable/bg_secondary_button" />
                <Button android:id="@+id/repeatButton" android:layout_width="wrap_content" android:layout_height="34dp" android:text="REPEAT" android:textSize="9sp" android:background="@drawable/bg_secondary_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="#14181D" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/downloadTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="GET MUSIC" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="11sp" />
        <TextView android:id="@+id/libraryTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="LIBRARY" android:textColor="#9AA4B2" android:textStyle="bold" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
