<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingStart="4dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/trackArt" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_wf_logo" android:contentDescription="Album artwork" android:background="#20262D" android:padding="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/trackTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F7FA" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/trackArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA4B2" android:textSize="12sp" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/trackDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#788392" android:textSize="11sp" android:layout_marginStart="8dp" />
</LinearLayout>
